# ─────────────────────────────────────────────────
# xiaoheihe-agent 配置模板
#
# 复制为 .env 后填入真实值。.env 已在 .gitignore 中。
# 真实 Cookie 绝不提交，绝不贴进聊天窗口，绝不写进 README。
# ─────────────────────────────────────────────────

# ── 凭据（二选一）──────────────────────────────────
# 方式 A：扫码登录后自动落到 .data/session.json（推荐，见 `xhh login`）
# 方式 B：手动粘贴完整 Cookie 字符串
XHH_COOKIE=

# 你的 heybox_id（登录后可查，`xhh whoami`）
XHH_HEYBOX_ID=

# ── 模式开关 ───────────────────────────────────────
# draft_only=true 时，所有发布动作只存草稿，绝不正式发布
# 首次接入请务必保持 true，跑通格式后再关闭
XHH_DRAFT_ONLY=true

# 回复模式：off / queue / auto
#   off   = 只记录不回复
#   queue = 生成回复进审核队列，等人放行（推荐起点，首版默认）
#   auto  = 自动发出
# 注意：即使设为 auto，规格 §5.7 第二道项（负面反馈/交易/承诺/被质问是否 AI）
# 仍强制进入 queue，不存在自动发出路径。
XHH_REPLY_MODE=queue

# ── 频率闸门（硬上限，代码里不允许绕过）────────────
XHH_MAX_POSTS_PER_DAY=3
XHH_MAX_REPLIES_PER_HOUR=5
XHH_MAX_REPLIES_PER_DAY=30
XHH_MAX_DM_PER_DAY=10

# ── 时间窗 ─────────────────────────────────────────
# 只处理这么多小时内的消息。更早的视为过期，不回。
XHH_MAX_MESSAGE_AGE_HOURS=6

# 轮询间隔（秒）
XHH_POLL_INTERVAL=600

# ── 身份（真人与 AI 混合运营）─────────────────────
# AI 主要负责发帖。被直接问到是否为 AI 生成时必须承认。
#   ask  = 只在被直接问到 AI 时承认（默认，推荐）
#   tag  = 每条内容都带 AI 标识
# 不提供"被问也否认"选项，代码层面不接受该值（见 README 红线 1）
XHH_AI_DISCLOSURE=ask

# ── 存储 ───────────────────────────────────────────
XHH_DB_PATH=.data/xhh.db

# ── 日志 ───────────────────────────────────────────
XHH_LOG_LEVEL=INFO
